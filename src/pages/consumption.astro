---
import Base from '../layouts/Base.astro';
import ConsumptionItem from '../components/ConsumptionItem.astro';
import { consumptionEntries } from '../lib/site';

// The ledger is noindex-adjacent by design: it has always been left out of
// /sitemap.xml, and the endpoint reads this flag instead of a second list.
export const sitemap = false;

// 4.2 MB of markup: too heavy to fetch in the service worker's install step on
// every first visit. The network-first fetch handler still caches it on open.
export const precache = false;

const entries = consumptionEntries();
---

<Base
  title="Media Consumption"
  description="Media consumption log — books, films, and games Avinash Saravanan has read, watched, or played."
  image="/assets/images/media/media-top.jpg"
  styleSheet="/assets/css/pages/consumption.css"
  pageScript="/assets/js/consumption.js"
>
<div class="page-top">
    <span class="hero-floor" aria-hidden="true">05</span>
    <div class="consumption-preamble">
        <h1 class="text-center">Media Consumption List</h1>
    </div>
    <div class="consumption-explanation">
        <p>What I have read, watched or played at any particular time in the past that I considered to be of note.</p>
        <p>If you are looking for my status log, read the <a href="/log/">status log</a>.</p>
    </div>
</div>

<div class="consumption-body">
    <div class="consumption-chronology" data-chronology data-visible="false">
        <div class="consumption-chronology__main">
            <span class="consumption-chronology__date" data-chronology-date>—</span>
            <span class="consumption-chronology__meta" data-chronology-meta></span>
            <select class="consumption-chronology__year" aria-label="Jump to year" data-year-jump>
                <option value="">Year</option>
            </select>
        </div>
        <span class="consumption-chronology__progress">
            <span data-chronology-progress></span>
        </span>
    </div>

    <div class="consumption-list full-res">
        <div class="row item title">
            <span class="col-12">Chronology · {entries.length} entries</span>
            <div class="col-12 consumption-year-jump-wrap">
                <label for="consumption-year-jump" class="consumption-year-jump-label">Jump to year</label>
                <select id="consumption-year-jump" class="consumption-year-jump" data-year-jump>
                    <option value="">—</option>
                </select>
            </div>
        </div>
        {entries.map((item, i) => <ConsumptionItem item={item} index={i + 1} view="desktop" />)}
    </div>

    <div class="consumption-list mobile-res">
        {entries.map((item, i) => <ConsumptionItem item={item} index={i + 1} view="mobile" />)}
    </div>
    <div class="consumption-sentinel" data-consumption-sentinel aria-hidden="true"></div>
</div>
</Base>
