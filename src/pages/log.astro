---
import Base from '../layouts/Base.astro';
import { logEntries, slugify } from '../lib/site';

const entries = logEntries();

// Jekyll grouped entries by the year at the end of the date string and printed
// the year heading the first time it changed.
const grouped: { year: string; items: typeof entries }[] = [];
for (const item of entries) {
  const year = item.date.split(' ').pop() as string;
  const last = grouped[grouped.length - 1];
  if (last && last.year === year) last.items.push(item);
  else grouped.push({ year, items: [item] });
}
---

<Base
  title="Status Log"
  description="Status log and updates by Avinash Saravanan."
  image="/assets/images/log/log.jpg"
  styleSheet="/assets/css/pages/log.css"
>
<div class="page-top log-hero">
    <span class="hero-floor" aria-hidden="true">13</span>
    <div class="log-preamble">
                <h1>Status <span>Log</span></h1>
        <p class="log-explanation">Goals, Achievements, and Changes in Goals</p>
    </div>
</div>

<div class="log-shell">

    <div class="log">
        {grouped.map((group) => (
            <>
                <div class="log-year" id={`year-${group.year}`}>
                    <span>{group.year}</span>
                </div>
                {group.items.map((item) => (
                    <article class="log-entry" id={slugify(item.date)}>
                        <div class="log-date">{item.date}</div>
                        <div class="log-card">
                            <div class="log-body" set:html={item.explanation} />
                            {(item.image || item.image2) && (
                                <div class:list={['log-media', item.image2 && 'log-media--pair']}>
                                    {item.image && (
                                        <figure class="log-figure">
                                            <img src={`/${item.image}`} alt={`Status log image for ${item.date}`} loading="lazy" decoding="async">
                                        </figure>
                                    )}
                                    {item.image2 && (
                                        <figure class="log-figure">
                                            <img src={`/${item.image2}`} alt={`Additional status log image for ${item.date}`} loading="lazy" decoding="async">
                                        </figure>
                                    )}
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </>
        ))}
    </div>
</div>
</Base>
