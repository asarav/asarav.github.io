---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import UiIcons from '../components/UiIcons.astro';
import { calendarEntries, pageTitle } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  styleSheet?: string;
  pageScript?: string;
  backgroundFractal?: boolean;
  homePage?: boolean;
  projectsAlternate?: boolean;
  /** Set when the emitted file name is not the route (404.html). */
  canonicalPath?: string;
}

const {
  title,
  description,
  image,
  styleSheet,
  pageScript,
  backgroundFractal = true,
  homePage = false,
  projectsAlternate = false,
  canonicalPath
} = Astro.props;

const pathname = Astro.url.pathname;
const calendarJson = JSON.stringify(calendarEntries());

// The schema.org graph Jekyll's layout emitted on every page.
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://asarav.github.io/#person',
      name: 'Avinash Saravanan',
      alternateName: 'asarav',
      url: 'https://asarav.github.io',
      jobTitle: ['Software Engineer', 'Computer Scientist', 'Writer'],
      knowsAbout: [
        'Software Engineering',
        'Machine Learning',
        'Human-Computer Interaction',
        'Science Fiction',
        'Music Composition'
      ],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'TU Delft' },
        { '@type': 'CollegeOrUniversity', name: 'University of Michigan' }
      ],
      sameAs: [
        'https://github.com/asarav',
        'https://www.linkedin.com/in/avinash-saravanan-profile/',
        'https://medium.com/@asarav'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': 'https://asarav.github.io/#website',
      url: 'https://asarav.github.io',
      name: 'Avinash Saravanan, asarav',
      inLanguage: 'en',
      publisher: { '@id': 'https://asarav.github.io/#person' }
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://asarav.github.io/#profile',
      url: 'https://asarav.github.io',
      name: 'Avinash Saravanan',
      isPartOf: { '@id': 'https://asarav.github.io/#website' },
      mainEntity: { '@id': 'https://asarav.github.io/#person' },
      about: { '@id': 'https://asarav.github.io/#person' }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <!-- Warm up connections to the image CDNs used by the consumption page. -->
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin>
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin>
    <link rel="preconnect" href="https://cdn.myanimelist.net" crossorigin>
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin>
    <link rel="preconnect" href="https://i.gr-assets.com" crossorigin>
    <link rel="dns-prefetch" href="https://images.gr-assets.com">
    {image && <link rel="preload" as="image" href={image} fetchpriority="high">}
    <title>{pageTitle(title, pathname)}</title>
    <meta name="author" content="Avinash Saravanan">
    <meta name="keywords" content="Avinash,Saravanan,Software,Engineer,Scientist,Novelist,Guitar,Games,Music,Dance,AI,Badass,asarav,Developer,Programmer">
    <meta name="google-site-verification" content="pgJJ8njw6GLljKN4caY8Xtz5zoMPTyBsdpK6CMRhNBM" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Fallback: if the typing enhancement never loads (slow or
      // failed connection), reveal the text so the page is usable.
      window.setTimeout(function () {
        if (!window.__heroTypedReady) {
          document.documentElement.classList.remove('js');
        }
      }, 5000);
      // Opt into scroll-triggered motion only when the browser can
      // support it. The timeout restores normal animations if the
      // motion bundle fails to load for any reason.
      (function () {
        var root = document.documentElement;

        if (!('IntersectionObserver' in window)) {
          return;
        }

        root.classList.add('js-motion');

        window.setTimeout(function () {
          if (!root.classList.contains('motion-ready')) {
            root.classList.remove('js-motion');
          }
        }, 1500);
      })();
    </script>
    <meta name="theme-color" content="#070b10">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.png">
    {projectsAlternate && <link rel="alternate" type="application/json" href="/projects.json" title="Machine-readable project index">}
    <script is:inline set:html={`window.__calendar = ${calendarJson};`} />
    {homePage && <link rel="preload" as="image" href="/assets/images/homepage_tiles/projects.jpg" fetchpriority="high">}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <!--Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;700&family=Syne:wght@700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="/assets/css/main.css">
    {styleSheet && <link rel="stylesheet" type="text/css" href={styleSheet}>}
    <Seo title={title} description={description} pathname={pathname} image={image} canonicalPath={canonicalPath} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />
    <script type="speculationrules" is:inline set:html={`{"prefetch":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}`} />
  </head>
  <body id="site" class:list={['site', homePage && 'home-page']} data-image-root="/assets/images/">
    <UiIcons />
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="status-scrim" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Nav currentPath={pathname} />
    <main id="content" class="container-fluid">
      <slot />
    </main>
    <Footer />
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous" is:inline></script>
    {pageScript && <script defer type="text/javascript" src={pageScript} is:inline></script>}
    <script defer type="text/javascript" src="/assets/js/media-fallback.js" is:inline></script>
    <script defer type="text/javascript" src="/assets/js/hero-typed.js" is:inline></script>
    <script defer type="text/javascript" src="/assets/js/site-motion.js" is:inline></script>
    <script defer type="text/javascript" src="/assets/js/fireworks.js" is:inline></script>
    {backgroundFractal && <script defer type="text/javascript" src="/assets/js/background-fractal.js" is:inline></script>}
    <script defer type="text/javascript" src="/assets/js/footer-fractal.js" is:inline></script>
    <script defer type="text/javascript" src="/assets/js/ambient-sound.js" is:inline></script>
    <script defer type="text/javascript" src="/assets/js/brand-mark.js" is:inline></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        var swHadController = !!navigator.serviceWorker.controller;
        var swReloading = false;
        navigator.serviceWorker.addEventListener('controllerchange', function () {
          // Only reload for an actual update, and only once.
          if (!swHadController || swReloading) {
            return;
          }
          swReloading = true;
          window.location.reload();
        });
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
